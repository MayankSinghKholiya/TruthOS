# ==== App ====
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_ALLOWED_ORIGINS=http://localhost:3000

# ==== Auth ====
JWT_SECRET_KEY=change-me-too
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== Postgres ====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=truthos
POSTGRES_PASSWORD=truthos
POSTGRES_DB=truthos
DATABASE_URL=postgresql+asyncpg://truthos:truthos@localhost:5432/truthos

# ==== Redis ====
REDIS_URL=redis://localhost:6379/0

# ==== Qdrant ====
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=truthos_documents

# ==== Neo4j ====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=truthos_neo4j

# ==== LLM Routing (OpenRouter) ====
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=anthropic/claude-sonnet-4.5
FALLBACK_MODEL=openai/gpt-4o-mini
JUDGE_MODEL=anthropic/claude-opus-4.1

# ==== Embeddings ====
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ==== External APIs ====
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
COINGECKO_API_KEY=
ALPHAVANTAGE_API_KEY=

# ==== Storage (Cloudflare R2) ====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=truthos-storage

# ==== Observability ====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
